{
  "delegates": {
    "version": 1,
    "maxParallel": 10,
    "publication": {
      "repository": "atlargelabs/aipatty",
      "remote": "origin",
      "baseBranch": "main",
      "requiredChecks": []
    },
    "environment": {
      "setup": [{ "name": "dependencies", "command": "npm ci --ignore-scripts", "timeoutMs": 600000 }],
      "checks": [
        { "name": "typecheck", "command": "npm run check", "timeoutMs": 120000 },
        { "name": "tests", "command": "npm test", "timeoutMs": 600000 }
      ]
    }
  }
}

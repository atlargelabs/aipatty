diff --git a/src/aipatty-log-file.ts b/src/aipatty-log-file.ts
new file mode 100644
index 0000000..7565a2d
--- /dev/null
+++ b/src/aipatty-log-file.ts
@@ -0,0 +1,24 @@
+import * as fs from "node:fs";
+import { dirname } from "node:path";
+
+/** Managed log paths are canonical. Reject links and special files, including during continuation. */
+export function openLog(file: string, append = false): number {
+	const dir = dirname(file);
+	if (fs.realpathSync(dir) !== dir) throw new Error("Refusing a linked delegate log directory");
+	const { O_CREAT, O_WRONLY, O_APPEND, O_NOFOLLOW, O_NONBLOCK } = fs.constants;
+	const fd = fs.openSync(file, O_CREAT | O_WRONLY | O_NOFOLLOW | O_NONBLOCK | (append ? O_APPEND : 0), 0o600);
+	try {
+		const stat = fs.fstatSync(fd);
+		if (!stat.isFile() || stat.nlink !== 1) throw new Error("Not an independent regular log file");
+		if (!append) fs.ftruncateSync(fd);
+		return fd;
+	} catch (error) {
+		fs.closeSync(fd);
+		throw error;
+	}
+}
+
+export function writeLog(file: string, text: string): void {
+	const fd = openLog(file);
+	try { fs.writeFileSync(fd, text); } finally { fs.closeSync(fd); }
+}
